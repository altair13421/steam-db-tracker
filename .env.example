# ============================================================
# Steam Tracker (Django) — example environment file.
# Copy this to ".env" and edit. All values optional — defaults
# are tuned for a single-container SQLite setup with the
# built-in scheduler running every 12 hours.
# ============================================================

# Django
DJANGO_SETTINGS_MODULE=steamtracker.settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,steam-tracker-web

# Docker bind mounts — set these to the host's `id -u` and `id -g` so the
# container can write data/, media/, and logs/.
DOCKER_UID=1000
DOCKER_GID=1000

# Database — defaults to SQLite at /app/data/steam.sqlite3.
# For Postgres use: postgres://user:pass@db:5432/steamtracker
DATABASE_URL=

# Steam storefront
STEAM_CC=us
STEAM_LANG=english

# Schedule — used by the `schedule` management command (scheduler service).
# Format: "<int> <unit>" e.g. "12 hours", "30 minutes", "1 day".
SCHEDULE_INTERVAL="12 hours"

# Polling throttle (don't change unless you know what you're doing).
STEAM_THROTTLE_SECONDS=4

# Media (chart PNGs, etc.) — defaults to /app/media
MEDIA_ROOT=/app/media

# Optional proxy if Steam is unreachable from your network.
# HTTP_PROXY=http://127.0.0.1:8080
